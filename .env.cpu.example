# LIVE profile for CPU-only machines (~1-2 FPS per camera). Run scripts/export_onnx.py first.
# Copy to .env:   copy .env.gpu.example .env
APP_MODE=live
LOG_LEVEL=INFO
CAMERAS_CONFIG=backend/config/cameras.yaml
EVIDENCE_DIR=evidence
DB_PATH=data/violations.db
EVIDENCE_RETENTION_DAYS=7
CORS_ORIGINS=http://localhost:5173
DEVICE=cpu
DETECTOR_WEIGHTS=yolo26n.onnx
DETECTOR_IMGSZ=640
DETECTOR_CONF=0.30
PIPELINE_FPS=5
MIN_RIDER_HEIGHT_PX=80
HELMET_WEIGHTS=backend/models/helmet/helmet_yolo11s.onnx
HELMET_IMGSZ=320
HELMET_CONF=0.35
PLATE_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
PLATE_DETECTOR_CONF=0.40
PLATE_MIN_WIDTH_PX=50
OCR_ENGINE=rapidocr
# Few looks per rider on CPU, so confirm after 3 of 6 (checked: no false positives on the demo clips).
VIOLATION_WINDOW=6
VIOLATION_MIN_HITS=3
VIOLATION_MIN_CONF=0.50
VIOLATION_MAX_HELMET_HITS=1
PLATE_WINDOW_S=3.0
PLATE_MAX_OCR_PER_TRACK=8
DEDUP_IOU=0.3
DEDUP_WINDOW_S=5.0
STREAM_FPS=15
STREAM_WIDTH=960
STREAM_JPEG_QUALITY=70
